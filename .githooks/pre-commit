#!/bin/sh
set -eu

echo "---------- Git hook: pre-commit ----------"

# Ruff (imports, lint, and format)
echo ""
echo ">>> [1/7] Running Ruff"
uv run ruff check --select I .
uv run ruff check .
uv run ruff format --check .

# Flake8 (lint)
echo ""
echo ">>> [2/7] Running Flake8"
uv run flake8 .

# MyPy (type checking)
echo ""
echo ">>> [3/7] Running MyPy"
uv run mypy .

# Pyright (type checking)
echo ""
echo ">>> [4/7] Running Pyright"
uv run pyright .

# Ty (type checking)
echo ""
echo ">>> [5/7] Running Ty"
uv run ty check . --error-on-warning

# Pyrefly (type checking)
echo ""
echo ">>> [6/7] Running Pyrefly"
uv run pyrefly check .

# Run tests
echo ""
echo ">>> [7/7] Running tests"
uv run coverage run -m unittest discover .
uv run coverage report --fail-under=90

echo "------------------------------------------"
